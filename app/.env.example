# MySQL (relational store)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=wms_app
MYSQL_PASSWORD=wms_mysql_demo_password
MYSQL_DATABASE=workload_management_system

# PostgreSQL + pgvector (vector store)
PG_HOST=localhost
PG_PORT=5433
PG_USER=wms_app
PG_PASSWORD=wms_pg_demo_password
PG_DATABASE=workload_management_vectors

# NextAuth
NEXTAUTH_SECRET=generate_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3000

# Optional OpenAI integration, server-side only. Without a key, summaries are
# explicitly labelled record-based and have no semantic search embedding.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# Set record to always use deterministic summaries; auto uses OpenAI if keyed.
AI_SUMMARY_MODE=auto
# Optional separate key for embeddings; otherwise OPENAI_API_KEY is used.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

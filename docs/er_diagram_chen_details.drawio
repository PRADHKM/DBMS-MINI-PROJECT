        <mxCell id="c73" value="A resignation may name 0..1 successor; one employee may receive several handovers." style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontColor=#526782;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="1180" width="650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c74" value="Procedure and trigger: no self-handover; successor must be active with no own notice." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#182b49;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1370" width="1140" height="50" as="geometry" />
